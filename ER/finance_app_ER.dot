digraph finance_app {
  graph [rankdir=LR, bgcolor="#0b1020", pad=0.35, nodesep=0.55, ranksep=0.95, splines=ortho];
  node [shape=box, style="rounded,filled", fillcolor="#141d2d", color="#465673", fontcolor="#eaf0fa", fontname="Arial", fontsize=12, margin="0.16,0.10"];
  edge [color="#93a5c3", fontcolor="#c5d0e2", fontname="Arial", fontsize=10, arrowsize=0.7];

  users [label="users\nid · full_name · email · role · is_active"];
  categories [label="categories\nid · user_id · name · type · color · icon"];
  transactions [label="transactions\nid · user_id · category_id · import_batch_id\ntype · amount · transaction_date · status\nIDX: user/date · user/status/type/date · user/category/status/type/date"];
  import_batches [label="import_batches\nid · user_id · file_name · file_hash · status\nrows_total · rows_imported · rows_skipped"];
  budgets [label="budgets\nid · user_id · year · month · amount"];
  budget_limits [label="budget_limits\nid · budget_id · category_id\nlimit_amount · warning_percent"];
  notifications [label="notifications\nid · user_id · budget_limit_id\ntype · title · message · is_read"];
  exchange_rates [label="exchange_rates\nPK: currency_code\nrate_rub · nominal · rate_date · fetched_at\nIDX: fetched_at"];

  users -> categories [label="1 : N"];
  users -> transactions [label="1 : N"];
  users -> import_batches [label="1 : N"];
  users -> budgets [label="1 : N"];
  users -> notifications [label="1 : N"];
  categories -> transactions [label="1 : N"];
  categories -> budget_limits [label="1 : N"];
  import_batches -> transactions [label="1 : 0..N"];
  budgets -> budget_limits [label="1 : N"];
  budget_limits -> notifications [label="0..1 : N"];
}
